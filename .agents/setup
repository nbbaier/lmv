#!/usr/bin/env bash
set -euo pipefail

started_at=$SECONDS
echo "[setup] Checking Bun"

bun_bin="$(command -v bun || true)"
if [[ -z "$bun_bin" ]]; then
	if [[ ! -x "$HOME/.bun/bin/bun" ]]; then
		echo "[setup] Installing Bun"
		curl -fsSL https://bun.sh/install | bash
	fi

	bun_bin="$HOME/.bun/bin/bun"
	profile_marker="# lmv Bun path"
	if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
		cat >> "$HOME/.bash_profile" <<'EOF'

# lmv Bun path
if [[ -d "$HOME/.bun/bin" ]]; then
	export BUN_INSTALL="$HOME/.bun"
	export PATH="$BUN_INSTALL/bin:$PATH"
fi
EOF
	fi
fi

echo "[setup] Installing dependencies"
install_started_at=$SECONDS
"$bun_bin" install --frozen-lockfile
echo "[setup] Dependencies ready in $((SECONDS - install_started_at))s"
echo "[setup] Complete in $((SECONDS - started_at))s"

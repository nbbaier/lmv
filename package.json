{
	"name": "lmv",
	"version": "0.2.0",
	"description": "Local Markdown Viewer - view and edit markdown files in your browser",
	"module": "src/cli.ts",
	"type": "module",
	"bin": {
		"lmv": "./src/cli.ts"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun run src/cli.ts",
		"build": "bun build src/cli.ts --compile --production --outfile dist/lmv",
		"build:all": "bun run scripts/build.ts",
		"build:cp": "bun run build && cp dist/lmv /Users/nbbaier/.local/bin/",
		"build:cp:optimized": "bun run build:all && bun run scripts/copy-optimized.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"@types/hast": "^3.0.4",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.2.2"
	},
	"peerDependencies": {
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"@radix-ui/react-toggle": "^1.1.10",
		"@radix-ui/react-tooltip": "^1.2.8",
		"beautiful-mermaid": "^1.1.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hast-util-to-text": "^4.0.2",
		"highlight.js": "^11.11.1",
		"lucide-react": "^1.7.0",
		"lowlight": "^3.3.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.5.0",
		"unist-util-visit": "^5.0.0",
		"yaml": "^2.8.3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dmmulroy/lmv.git"
	},
	"license": "MIT",
	"author": "Dillon Mulroy"
}
